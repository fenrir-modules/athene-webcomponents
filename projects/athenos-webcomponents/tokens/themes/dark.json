        "$value": "{color.border.border}"
      }
    }
  },
  "shadow": {
    "shadow-1": {
      "$value": "0 1px 3px rgba(0, 0, 0, 0.45), 0 1px 2px rgba(0, 0, 0, 0.3)"
    },
    "shadow-2": {
      "$value": "0 4px 16px -2px rgba(0, 0, 0, 0.5), 0 2px 5px -1px rgba(0, 0, 0, 0.3)"
    },
    "shadow-3": {
      "$value": "0 20px 52px -12px rgba(0, 0, 0, 0.7), 0 8px 16px -4px rgba(0, 0, 0, 0.4)"
    },
    "shadow-drawer": {
      "$value": "8px 0 24px -6px rgba(0, 0, 0, 0.55)"
    },
    "toast-shadow": {
      "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.05), 0 1px 2px rgba(0, 0, 0, 0.5), 0 10px 24px -6px rgba(0, 0, 0, 0.55), 0 28px 56px -16px rgba(0, 0, 0, 0.7)"
    }

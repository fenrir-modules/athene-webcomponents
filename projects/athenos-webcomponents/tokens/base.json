{
  "color": {
    "$description": "Colour tokens. Light values here; [data-theme=\"dark\"] overrides live in themes/dark.json, accent presets in accents/*.json.",
    "surface": {
      "$description": "Surfaces — neutral, calm. Hierarchy: bg-0 (canvas) → bg-1 (chrome) → surface (cards) → bg-2 (fill).",
      "$type": "color",
      "bg-0": {
        "$value": "#f4f4f6",
        "$description": "App background — subtle cool off-white"
      },
      "bg-1": {
        "$value": "#ffffff",
        "$description": "Sidebar / topbar / chrome — clean white"
      },
      "bg-2": {
        "$value": "#efeff2",
        "$description": "Hover fills, section heads, segmented bg"
      },
      "surface": {
        "$value": "#ffffff",
        "$description": "Cards / panels / modals"
      },
      "surface-2": {
        "$value": "#f9f9fb",
        "$description": "Recessed within cards — table heads"
      },
      "surface-3": {
        "$value": "#eaeaed",
        "$description": "Deep wells — inputs, kbd, inner fills"
      },
      "hover": {
        "$value": "#00000009",
        "$description": "3.5% black overlay for hover"
      },
      "hover-strong": {
        "$value": "#00000013",
        "$description": "7% black overlay for active"
      },
      "selected": {
        "$value": "#4f46e50e",
        "$description": "Subtle accent tint for selected rows"
      },
      "scrim": {
        "$value": "#00000066",
        "$description": "Backdrop behind modal dialogs and sheets (::backdrop of ath-dialog)."
      }
    },
    "border": {
      "$description": "Borders — hairlines, soft.",
      "$type": "color",
      "border": {
        "$value": "#e2e2e6"
      },
      "border-strong": {
        "$value": "#ccccd0"
      },
      "border-faint": {
        "$value": "#ebebee"
      },
      "rule": {
        "$value": "#e2e2e6"
      }
    },
    "text": {
      "$description": "Text hierarchy — no pure black. fg-3/fg-4/fg-label carry real small text, so they clear 4.5:1 on white, the canvas (bg-0) and surface-2 (checked by the contrast gate in tokens.config.json).",
      "$type": "color",
      "fg": {
        "$value": "#1a1a1e"
      },
      "fg-2": {
        "$value": "#3c3c44"
      },
      "fg-3": {
        "$value": "#5c5c65",
        "$description": "6.6:1 white · 6.0 canvas · 5.8 bg-2"
      },
      "fg-4": {
        "$value": "#6c6c76",
        "$description": "5.2:1 white · 4.7 canvas · 4.5 bg-2"
      },
      "fg-label": {
        "$value": "#6e6e73",
        "$description": "Tertiary label grey: section labels, weekday names, time-gutter labels, card keys. Was #8b8b90 (3.4:1); now 5.1:1 white · 4.6 canvas · 4.8 surface-2 so it may carry text (WCAG 1.4.3)."
      },
      "fg-disabled": {
        "$value": "#c8c8d0"
      }
    },
    "accent": {
      "$description": "Accent — default violet (overridden per data-accent, see accents/*.json).",
      "$type": "color",
      "accent": {
        "$value": "#4f46e5"
      },
      "accent-2": {
        "$value": "#4338ca"
      },
      "accent-3": {
        "$value": "#6366f1"
      },
      "accent-dim": {
        "$value": "#818cf8"
      },
      "accent-text": {
        "$value": "{color.accent.accent}",
        "$description": "Accent that carries text (links, mentions, active labels on an accent tint). Violet --accent clears 4.5:1 here; the blue, green and orange presets and dark use --accent-2, the step further from the surface (contrast gate)."
      },
      "accent-faint": {
        "$value": "#4f46e50f"
      },
      "accent-ring": {
        "$value": "#4f46e526",
        "$description": "Soft accent halo. Decorative only (≈1.3:1): use it next to a border that turns --accent, never as the only focus indicator — that is --focus-ring-shadow / --focus-ring-color."
      },
      "accent-solid": {
        "$value": "{color.accent.accent}",
        "$description": "Light: the accent fill under a white label (primary button). Violet and blue use --accent; the green and orange presets step down to --accent-2 so white clears 4.5:1. Dark's primary reads --accent directly, so this step only matters in light."
      }
    },
    "focus": {
      "$description": "Focus indicator (WCAG 2.4.7 / 1.4.11). The ring colour clears 3:1 against every surface in every theme and accent (contrast gate); --focus-ring-shadow adds a surface-coloured gap so it also reads on accent fills.",
      "focus-ring-color": {
        "$value": "{color.accent.accent}",
        "$type": "color",
        "$description": "Outline / ring colour for :focus-visible."
      },
      "focus-ring-shadow": {
        "$value": "0 0 0 2px {color.surface.surface}, 0 0 0 4px {color.focus.focus-ring-color}",
        "$type": "shadow",
        "$description": "box-shadow focus ring: 2px gap + 2px ring. Pair with outline: none. (Not named --focus-ring: the app already reads var(--focus-ring, …) as an outline colour.)"
      },
      "field-focus-shadow": {
        "$value": "0 0 0 3px {color.accent.accent-ring}",
        "$type": "shadow",
        "$description": "Form fields (input, textarea, select, pickers, editors): a soft accent halo outside the field's border, which turns --focus-ring-color and carries the 3:1 indicator. One line, never the gap ring of --focus-ring-shadow. Pair with outline: none (mixin field-focus)."
      }
    },
    "role": {
      "$description": "Semantic roles — what a component reaches for instead of the raw accent. Both themes point the interactive roles at the accent (dark only re-values what differs): the primary button fills with --accent-solid in light and --accent in dark; checked controls, progress, indicators and active borders use --accent; selection and active states use accent tints with --accent-text on top. The neutral preset keeps the monochrome light look (ink CTAs, grey selection) through accents/neutral.light-roles.json.",
      "ink": {
        "$type": "color",
        "ink": {
          "$value": "#17171a"
        },
        "ink-hover": {
          "$value": "#2e2e34"
        }
      },
      "action-primary": {
        "action-primary-bg": {
          "$value": "{color.accent.accent-solid}",
          "$type": "color"
        },
        "action-primary-bg-hover": {
          "$value": "color-mix(in srgb, {color.accent.accent-solid} 86%, #000)",
          "$type": "color"
        },
        "action-primary-bg-active": {
          "$value": "color-mix(in srgb, {color.accent.accent-solid} 74%, #000)",
          "$type": "color"
        },
        "action-primary-fg": {
          "$value": "#ffffff",
          "$type": "color"
        },
        "action-primary-disabled-bg": {
          "$value": "{color.role.action-primary.action-primary-bg}",
          "$type": "color"
        },
        "action-primary-disabled-fg": {
          "$value": "{color.role.action-primary.action-primary-fg}",
          "$type": "color"
        },
        "action-primary-disabled-border": {
          "$value": "{color.role.action-primary.action-primary-bg}",
          "$type": "color"
        },
        "action-primary-disabled-opacity": {
          "$value": 0.38,
          "$type": "number"
        }
      },
      "action-danger": {
        "$type": "color",
        "action-danger-bg": {
          "$value": "{color.status.red}",
          "$description": "Solid destructive button (ath-button variant=\"danger\"). White label 4.8:1."
        },
        "action-danger-bg-hover": {
          "$value": "color-mix(in srgb, {color.role.action-danger.action-danger-bg} 86%, #000)",
          "$description": "Deepened fill on hover, in both themes."
        },
        "action-danger-fg": {
          "$value": "#ffffff"
        }
      },
      "nav": {
        "$type": "color",
        "nav-active-bg": {
          "$value": "color-mix(in srgb, {color.accent.accent} 12%, transparent)",
          "$description": "12% accent — a tinted pill on the chrome, as in dark"
        },
        "nav-active-bg-hover": {
          "$value": "color-mix(in srgb, {color.accent.accent} 18%, transparent)"

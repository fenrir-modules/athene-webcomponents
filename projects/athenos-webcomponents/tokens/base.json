    "toast": {
      "$description": "Toast notifications (W5-D): a calm, slightly translucent surface over a light backdrop blur, a hairline edge and a soft layered shadow. The variant shows only in the icon disc and the time-left hairline.",
      "toast-bg": {
        "$value": "color-mix(in srgb, {color.surface.surface} 90%, transparent)",
        "$type": "color",
        "$description": "90% opaque: text keeps its contrast over any page; the rest is the blurred page behind."
      },
      "toast-border": {
        "$value": "rgba(15, 23, 42, 0.08)",
        "$type": "color"
      },
      "toast-tint-mix": {

    "tone-text": {
      "$description": "Text in a colour the app passes in (a project colour: calendar blocks, the board's project key): color-mix(in srgb, <colour> var(--tone-text-mix), var(--fg)). Mixing towards --fg gives a darker shade of the same hue in light and a lighter one in dark, so the project palette (--accent in every preset, --blue, --green, --amber, --purple) clears 4.5:1 on its own 7% tint (light ≥ 4.9, dark ≥ 4.7). A very light custom colour (yellow) can still fall short.",
      "tone-text-mix": {
        "$value": "65%",
        "$description": "share of the passed colour; the rest is --fg"
      }
    },
    "deco": {
      "$description": "Decorative status marks (board column bars, ticket-group dots, sidebar project-key chips): the status hue at ~60% strength over the surface. Status icons and due text keep the full colour.",
      "deco-mix": {
        "$value": "60%"
      },
      "red-muted": {
        "$value": "color-mix(in srgb, {color.status.red} {color.deco.deco-mix}, {color.surface.surface})",
        "$type": "color"
      },
      "amber-muted": {

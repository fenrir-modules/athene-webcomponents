          "$value": "{color.accent.accent}"
        },
        "control-mark": {
          "$value": "{color.role.control.control-checked}",
          "$description": "Marks that were ink before the accent presets reached light (a done task box, an editor checkbox, a pressed toggle's border, an ink focus outline): the checked-control colour in light, so ink under neutral; ink in dark, which keeps its look."
        }
      },
      "selection-bar": {

        "$type": "color",
        "action-create-bg": {
          "$value": "#3b825f",
          "$description": "Topbar \"+ New\" (ref 01: green, not ink). Was #43946c (white text 3.7:1); darkened to 4.6:1. Page-head primaries stay ink; this is the one global \"make something\" button."
        },
        "action-create-bg-hover": {
          "$value": "#327353"

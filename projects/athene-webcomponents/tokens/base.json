        "$value": "{color.status.red-text}"
      },
      "due-today": {
        "$value": "{color.status.red-text}",
        "$description": "today is red, as in the reference screens (04-mywork, 05-tickets)"
      },
      "due-soon": {
        "$value": "{color.status.amber-text}",

    "status": {
      "$description": "Status — muted, used as dots + subtle fills. Where a status colour carries text, use its *-text variant: a darker (light) or lighter (dark) shade of the same hue that clears 4.5:1 on the surfaces and on its own tint (contrast gate).",
      "$type": "color",
      "red": {
        "$value": "#dc2626",
        "$description": "Icons, dots, fills and borders. Text uses --red-text (--red is 4.0:1 on its tint)."
      },
      "red-text": {
        "$value": "#c31f1f",
        "$description": "Red that carries text (overdue, errors, danger items): 5.9:1 white · 5.4 canvas · 5.0 on --red-tint."
      },
      "amber": {
        "$value": "#cc7c2e",
        "$description": "Measured on the reference's in-progress icons. Icons, dots and fills only (3.2:1 on white) — text uses --amber-text."
      },
      "amber-text": {
        "$value": "#935921",
        "$description": "Amber that carries text (due \"soon\", warnings): 5.7:1 white · 5.2 canvas · 4.9 on --amber-tint. Was #9e6024 (4.35 on its tint)."
      },
      "blue": {

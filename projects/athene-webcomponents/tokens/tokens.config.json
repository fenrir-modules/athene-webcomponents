{
  "$comment": "Athene token pipeline config. scripts/tokens/build.mjs reads this; blocks are emitted in this order (= cascade order).",
  "base": "base.json",
  "outputs": {
    "scss": "../src/lib/styles/_tokens.scss",
    "customProperties": "../src/lib/styles/tokens.custom-properties.json",
    "inventory": "../src/lib/styles/tokens.inventory.json"
  },
  "contexts": {
    "theme": ["light", "dark"],
    "accent": [null, "violet", "blue", "green", "orange", "neutral"]
  },
  "canvas": "bg-0",
  "blocks": [
    {
      "title": "LIGHT (default) — no data-theme attribute, or data-theme=\"light\"",
      "selector": ":root,\n[data-theme=\"light\"]",
      "set": "base.json",
      "declarations": {
        "color-scheme": "light"
      }
    },
    {
      "title": "DARK",
      "selector": "[data-theme=\"dark\"]",
      "when": {
        "theme": "dark"
      },
      "set": "themes/dark.json",
      "declarations": {
        "color-scheme": "dark"
      }
    },
    {
      "title": "ACCENT violet — light",
      "selector": "[data-accent=\"violet\"]",
      "when": {
        "accent": "violet"
      },
      "set": "accents/violet.light.json"
    },
    {
      "title": "ACCENT blue — light",
      "selector": "[data-accent=\"blue\"]",
      "when": {
        "accent": "blue"
      },
      "set": "accents/blue.light.json"
    },
    {
      "title": "ACCENT green — light",
      "selector": "[data-accent=\"green\"]",
      "when": {
        "accent": "green"
      },
      "set": "accents/green.light.json"
    },
    {
      "title": "ACCENT orange — light",
      "selector": "[data-accent=\"orange\"]",
      "when": {
        "accent": "orange"
      },
      "set": "accents/orange.light.json"
    },
    {
      "title": "ACCENT neutral — light",
      "selector": "[data-accent=\"neutral\"]",
      "when": {
        "accent": "neutral"
      },
      "set": "accents/neutral.light.json"
    },
    {
      "title": "ACCENT violet — dark",
      "selector": "[data-theme=\"dark\"][data-accent=\"violet\"]",
      "when": {
        "theme": "dark",
        "accent": "violet"
      },
      "set": "accents/violet.dark.json"
    },
    {
      "title": "ACCENT blue — dark",
      "selector": "[data-theme=\"dark\"][data-accent=\"blue\"]",
      "when": {
        "theme": "dark",
        "accent": "blue"
      },
      "set": "accents/blue.dark.json"
    },
    {
      "title": "ACCENT green — dark",
      "selector": "[data-theme=\"dark\"][data-accent=\"green\"]",
      "when": {
        "theme": "dark",
        "accent": "green"
      },
      "set": "accents/green.dark.json"
    },
    {
      "title": "ACCENT orange — dark",
      "selector": "[data-theme=\"dark\"][data-accent=\"orange\"]",
      "when": {
        "theme": "dark",
        "accent": "orange"
      },
      "set": "accents/orange.dark.json"
    },
    {
      "title": "ACCENT neutral — dark",
      "selector": "[data-theme=\"dark\"][data-accent=\"neutral\"]",
      "when": {
        "theme": "dark",
        "accent": "neutral"
      },
      "set": "accents/neutral.dark.json"
    }
  ],
  "contrast": [
    {
      "fg": "focus-ring-color",
      "bg": ["surface", "bg-0", "bg-1", "bg-2", "surface-2"],
      "min": 3,
      "why": "WCAG 1.4.11 — focus indicator vs adjacent colours"
    },
    {
      "fg": "fg",
      "bg": ["surface", "bg-0", "bg-1", "surface-2", "bg-2", "surface-3"],
      "min": 4.5,
      "why": "WCAG 1.4.3 body text"
    },
    {
      "fg": "fg-2",
      "bg": ["surface", "bg-0", "bg-1", "surface-2", "bg-2", "surface-3"],
      "min": 4.5,
      "why": "WCAG 1.4.3"
    },
    {
      "fg": "fg-3",
      "bg": ["surface", "bg-0", "bg-1", "surface-2", "bg-2"],
      "min": 4.5,
      "why": "WCAG 1.4.3 — meta, keys, hints"
    },
    {
      "fg": "fg-4",
      "bg": ["surface", "bg-0", "bg-1", "surface-2", "bg-2"],
      "min": 4.5,
      "why": "WCAG 1.4.3 — quietest text step"
    },
    {
      "fg": "fg-label",
      "bg": ["surface", "bg-0", "bg-1", "surface-2"],
      "min": 4.5,
      "why": "WCAG 1.4.3 — labels are the only carrier of e.g. calendar weekday text"
    },
    {
      "fg": "amber-text",
      "bg": ["surface", "bg-0", "bg-1", "surface-2", "bg-2"],
      "min": 4.5,
      "why": "WCAG 1.4.3 — amber status text (due \"soon\", warnings)"
    },
    {
      "fg": "amber-text",
      "bg": ["amber-tint"],
      "over": ["bg-0", "surface"],
      "min": 4.5,
      "why": "WCAG 1.4.3 — amber text on its tint (alert, badge, chip)"
    },
    {
      "fg": "red-text",
      "bg": ["surface", "bg-0", "bg-1", "surface-2", "bg-2"],
      "min": 4.5,
      "why": "WCAG 1.4.3 — overdue and today, errors, danger items"
    },
    {
      "fg": "red-text",
      "bg": ["red-tint"],
      "over": ["bg-0", "surface"],
      "min": 4.5,
      "why": "WCAG 1.4.3 — red text on its tint (alert, badge, chip)"
    },
    {
      "fg": "green-text",
      "bg": ["surface", "bg-0", "bg-1", "surface-2", "bg-2"],
      "min": 4.5,
      "why": "WCAG 1.4.3 — success, met, trend up"
    },
    {
      "fg": "green-text",
      "bg": ["green-tint"],
      "over": ["bg-0", "surface"],
      "min": 4.5,
      "why": "WCAG 1.4.3 — green text on its tint (alert, badge, chip)"
    },
    {
      "fg": "blue-text",
      "bg": ["surface", "bg-0", "bg-1", "surface-2", "bg-2"],
      "min": 4.5,
      "why": "WCAG 1.4.3 — info"
    },
    {
      "fg": "blue-text",
      "bg": ["blue-tint"],
      "over": ["bg-0", "surface"],
      "min": 4.5,
      "why": "WCAG 1.4.3 — blue text on its tint (alert, badge, chip)"
    },
    {
      "fg": "purple-text",
      "bg": ["surface", "bg-0", "bg-1", "surface-2", "bg-2"],
      "min": 4.5,
      "why": "WCAG 1.4.3 — purple status text"
    },
    {
      "fg": "purple-text",
      "bg": ["purple-tint"],
      "over": ["bg-0", "surface"],
      "min": 4.5,
      "why": "WCAG 1.4.3 — purple text on its tint (alert, badge, chip)"
    },
    {
      "fg": "accent-text",
      "bg": ["surface", "bg-0", "bg-1", "surface-2"],
      "min": 4.5,
      "why": "WCAG 1.4.3 — links, mentions, accent labels"
    },
    {
      "fg": "accent-text",
      "bg": ["accent-faint", "accent-ring"],
      "over": ["bg-0", "surface"],
      "min": 4.5,
      "why": "WCAG 1.4.3 — accent text on accent tints (file drop, mentions)"
    },
    {
      "fg": "action-create-fg",
      "bg": ["action-create-bg", "action-create-bg-hover", "action-create-bg-active"],
      "min": 4.5,
      "why": "WCAG 1.4.3 — \"+ New\" label"
    },
    {
      "fg": "action-primary-fg",
      "bg": ["action-primary-bg", "action-primary-bg-hover", "action-primary-bg-active"],
      "min": 4.5,
      "why": "WCAG 1.4.3 — primary button label, also pressed"
    },
    {
      "fg": "action-danger-fg",
      "bg": ["action-danger-bg", "action-danger-bg-hover"],
      "min": 4.5,
      "why": "WCAG 1.4.3 — danger button label"
    },
    {
      "fg": "tab-active-fg",
      "bg": ["surface", "bg-0", "bg-1"],
      "min": 4.5,
      "why": "WCAG 1.4.3 — active tab label (accent in dark)"
    },
    {
      "fg": "nav-active-fg",
      "bg": ["nav-active-bg", "nav-active-bg-hover"],
      "over": ["bg-1"],
      "min": 4.5,
      "why": "WCAG 1.4.3 — active nav item on its pill"
    },
    {
      "fg": "nav-badge-fg",
      "bg": ["nav-badge-bg"],
      "over": ["bg-1"],
      "min": 4.5,
      "why": "WCAG 1.4.3 — nav count badge"
    },
    {
      "fg": "segment-count-active-fg",
      "bg": ["segment-count-active-bg"],
      "over": ["segment-active-bg"],
      "min": 4.5,
      "why": "WCAG 1.4.3 — count in the active segment / tab"
    },
    {
      "fg": "chip-primary-fg",
      "bg": ["chip-primary-bg"],
      "over": ["bg-0", "surface"],
      "min": 4.5,
      "why": "WCAG 1.4.3 — primary tag chip"
    },
    {
      "fg": "chip-active-fg",
      "bg": ["chip-active-bg"],
      "over": ["bg-0", "surface"],
      "min": 4.5,
      "why": "WCAG 1.4.3 — active filter chip"
    },
    {
      "fg": "action-outline-fg",
      "bg": ["surface", "bg-0", "bg-1"],
      "min": 4.5,
      "why": "WCAG 1.4.3 — outline button label"
    },
    {
      "fg": "action-outline-fg",
      "bg": ["action-outline-hover-bg"],
      "over": ["bg-0", "surface"],
      "min": 4.5,
      "why": "WCAG 1.4.3 — outline button label on hover"
    },
    {
      "fg": "selection-bar-fg",
      "bg": ["selection-bar-bg"],
      "over": ["bg-0", "surface"],
      "min": 4.5,
      "why": "WCAG 1.4.3 — bulk selection bar"
    },
    {
      "fg": "avatar-1-fg",
      "bg": ["avatar-1-bg"],
      "min": 4.5,
      "why": "WCAG 1.4.3 — avatar initials"
    },
    {
      "fg": "avatar-2-fg",
      "bg": ["avatar-2-bg"],
      "min": 4.5,
      "why": "WCAG 1.4.3 — avatar initials"
    },
    {
      "fg": "avatar-3-fg",
      "bg": ["avatar-3-bg"],
      "min": 4.5,
      "why": "WCAG 1.4.3 — avatar initials"
    },
    {
      "fg": "avatar-4-fg",
      "bg": ["avatar-4-bg"],
      "min": 4.5,
      "why": "WCAG 1.4.3 — avatar initials"
    },
    {
      "fg": "avatar-5-fg",
      "bg": ["avatar-5-bg"],
      "min": 4.5,
      "why": "WCAG 1.4.3 — avatar initials"
    },
    {
      "fg": "avatar-6-fg",
      "bg": ["avatar-6-bg"],
      "min": 4.5,
      "why": "WCAG 1.4.3 — avatar initials"
    },
    {
      "fg": "avatar-7-fg",
      "bg": ["avatar-7-bg"],
      "min": 4.5,
      "why": "WCAG 1.4.3 — avatar initials"
    },
    {
      "fg": "avatar-8-fg",
      "bg": ["avatar-8-bg"],

{
  "name": "@athene/webcomponents",
  "version": "0.1.0",
  "description": "Athene UI Component Library",
  "module": "dist/athene-webcomponents/fesm2022/athene-webcomponents.mjs",
  "typings": "dist/athene-webcomponents/index.d.ts",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./dist/athene-webcomponents/index.d.ts",
      "esm2022": "./dist/athene-webcomponents/esm2022/athene-webcomponents.mjs",
      "esm": "./dist/athene-webcomponents/esm2022/athene-webcomponents.mjs",
      "default": "./dist/athene-webcomponents/fesm2022/athene-webcomponents.mjs"
    },
    "./core": {
      "types": "./dist/athene-webcomponents/core/index.d.ts",
      "esm2022": "./dist/athene-webcomponents/esm2022/core/athene-webcomponents-core.mjs",
      "esm": "./dist/athene-webcomponents/esm2022/core/athene-webcomponents-core.mjs",
      "default": "./dist/athene-webcomponents/fesm2022/athene-webcomponents-core.mjs"
    },
    "./styles": {
      "default": "./dist/athene-webcomponents/styles/main.scss"
    },
    "./styles/*": {
      "default": "./dist/athene-webcomponents/styles/*"
    }
  },
  "files": [
    "dist/athene-webcomponents/**"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "tokens:build": "node scripts/tokens/build.mjs",
    "tokens:check": "node scripts/tokens/build.mjs --check",
    "tokens:parity": "node scripts/tokens/parity.mjs",
    "tokens:report-app": "node scripts/tokens/report-app.mjs",
    "build:lib": "npm run tokens:build && ng build athene-webcomponents",
    "check:dist": "npm run build:lib && node scripts/check-package.mjs --dist",
    "prepublishOnly": "npm run build:lib",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:tokens": "node --test scripts/tokens/*.test.mjs",
    "lint": "npm run lint:shared && npm run lint:es && npm run lint:styles && npm run lint:i18n && npm run lint:ts && npm run lint:a11y && npm run tokens:check && npm run format:check && npm run lint:knip",
    "lint:shared": "node scripts/shared-config.mjs",
    "lint:es": "eslint \"projects/**/*.{ts,html}\" --max-warnings=0",
    "lint:ts": "tsc -p projects/athene-webcomponents/tsconfig.lib.json --noEmit && tsc -p projects/athene-webcomponents/tsconfig.spec.json --noEmit",
    "lint:a11y": "node scripts/lint-a11y.mjs",
    "lint:styles": "stylelint \"projects/**/*.scss\"",
    "lint:styles:baseline": "stylelint \"projects/**/*.scss\" --suppress",
    "lint:i18n": "node scripts/i18n-check.mjs",
    "lint:knip": "node scripts/knip-check.mjs",
    "lint:fix": "eslint \"projects/**/*.{ts,html}\" --fix --prune-suppressions && stylelint \"projects/**/*.scss\" --fix",
    "lint:baseline:prune": "eslint \"projects/**/*.{ts,html}\" --prune-suppressions && stylelint \"projects/**/*.scss\" && stylelint \"projects/**/*.scss\" --suppress && node scripts/knip-check.mjs --prune",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "storybook": "ng run athene-webcomponents:storybook",
    "build-storybook": "ng run athene-webcomponents:build-storybook --quiet",
    "test:storybook": "playwright test -c tests/storybook/playwright.config.ts",
    "test:storybook:update": "playwright test -c tests/storybook/playwright.config.ts --update-snapshots=all",
    "test:storybook:a11y-baseline": "SB_VISUAL=off SB_A11Y_BASELINE=update playwright test -c tests/storybook/playwright.config.ts"
  },
  "private": false,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "lucide-angular": "^0.469.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.0",
    "@angular/cli": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/angular": "10.6.1",
    "@types/jasmine": "~5.1.0",
    "@typescript-eslint/utils": "8.58.0",
    "angular-eslint": "18.4.3",
    "eslint": "9.39.4",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "knip": "6.40.0",
    "ng-packagr": "^18.2.0",
    "postcss-scss": "^4.0.9",
    "prettier": "3.8.1",
    "storybook": "10.6.1",
    "stylelint": "~17.16.0",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "typescript": "~5.5.2",
    "typescript-eslint": "8.58.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  }
}

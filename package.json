{
  "name": "@athenos/webcomponents",
  "version": "0.7.6",
  "description": "Athenos UI Component Library",
  "module": "dist/athenos-webcomponents/fesm2022/athenos-webcomponents.mjs",
  "typings": "dist/athenos-webcomponents/types/athenos-webcomponents.d.ts",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./dist/athenos-webcomponents/types/athenos-webcomponents.d.ts",
      "default": "./dist/athenos-webcomponents/fesm2022/athenos-webcomponents.mjs"
    },
    "./core": {
      "types": "./dist/athenos-webcomponents/types/athenos-webcomponents-core.d.ts",
      "default": "./dist/athenos-webcomponents/fesm2022/athenos-webcomponents-core.mjs"
    },
    "./icons": {
      "types": "./dist/athenos-webcomponents/types/athenos-webcomponents-icons.d.ts",
      "default": "./dist/athenos-webcomponents/fesm2022/athenos-webcomponents-icons.mjs"
    },
    "./styles": {
      "default": "./dist/athenos-webcomponents/styles/main.scss"
    },
    "./styles/*": {
      "default": "./dist/athenos-webcomponents/styles/*"
    }
  },
  "files": [
    "dist/athenos-webcomponents/**"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "tokens:build": "node scripts/tokens/build.mjs",
    "tokens:check": "node scripts/tokens/build.mjs --check",
    "tokens:parity": "node scripts/tokens/parity.mjs",
    "tokens:report-app": "node scripts/tokens/report-app.mjs",
    "build:lib": "npm run tokens:build && ng build athenos-webcomponents && node scripts/normalize-dist.mjs",
    "check:dist": "npm run build:lib && node scripts/check-package.mjs --dist",
    "prepublishOnly": "npm run build:lib",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:zoneless": "ng test -c zoneless",
    "test:tokens": "node --test scripts/tokens/*.test.mjs",
    "lint": "npm run lint:shared && npm run lint:es && npm run lint:styles && npm run lint:i18n && npm run lint:ts && npm run lint:a11y && npm run tokens:check && npm run format:check && npm run lint:knip",
    "lint:shared": "node scripts/shared-config.mjs",
    "lint:es": "eslint \"projects/**/*.{ts,html}\" --max-warnings=0",
    "lint:ts": "tsc -p projects/athenos-webcomponents/tsconfig.lib.json --noEmit && tsc -p projects/athenos-webcomponents/tsconfig.spec.json --noEmit",
    "lint:a11y": "node scripts/lint-a11y.mjs",
    "lint:styles": "stylelint \"projects/**/*.scss\"",
    "lint:styles:baseline": "stylelint \"projects/**/*.scss\" --suppress",
    "lint:i18n": "node scripts/i18n-check.mjs",
    "lint:knip": "node scripts/knip-check.mjs",
    "lint:fix": "eslint \"projects/**/*.{ts,html}\" --fix --prune-suppressions && stylelint \"projects/**/*.scss\" --fix",
    "lint:baseline:prune": "eslint \"projects/**/*.{ts,html}\" --prune-suppressions && stylelint \"projects/**/*.scss\" && stylelint \"projects/**/*.scss\" --suppress && node scripts/knip-check.mjs --prune",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "storybook": "ng run athenos-webcomponents:storybook",
    "build-storybook": "ng run athenos-webcomponents:build-storybook --quiet",
    "test:storybook": "playwright test -c tests/storybook/playwright.config.ts",
    "test:storybook:update": "playwright test -c tests/storybook/playwright.config.ts --update-snapshots=all",
    "test:storybook:a11y-baseline": "SB_VISUAL=off SB_A11Y_BASELINE=update playwright test -c tests/storybook/playwright.config.ts"
  },
  "private": false,
  "dependencies": {
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/router": "22.2.2",
    "@lucide/angular": "1.55.0",
    "lucide": "1.55.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.2.2",
    "@angular/animations": "22.2.2",
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@angular/platform-browser-dynamic": "22.2.2",
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/angular": "10.6.2",
    "@typescript-eslint/utils": "8.71.2",
    "@vitest/browser-playwright": "5.0.4",
    "angular-eslint": "22.6.0",
    "eslint": "10.12.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "knip": "6.41.0",
    "ng-packagr": "22.2.4",
    "postcss-scss": "4.0.9",
    "prettier": "3.8.1",
    "storybook": "10.6.2",
    "stylelint": "17.16.0",
    "stylelint-value-no-unknown-custom-properties": "6.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4",
    "zone.js": "0.16.3"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "overrides": {
    "handlebars": "4.7.10",
    "vite": "8.3.4",
    "zod": "4.6.7"
  }
}

{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "athene-webcomponents": {
      "projectType": "library",
      "root": "projects/athene-webcomponents",
      "sourceRoot": "projects/athene-webcomponents/src",
      "prefix": "ath",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/athene-webcomponents/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/athene-webcomponents/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/athene-webcomponents/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/athene-webcomponents/tsconfig.spec.json",
            "polyfills": ["zone.js", "zone.js/testing"],
            "styles": ["projects/athene-webcomponents/src/lib/styles/main.scss"]
          },
          "configurations": {
            "zoneless": {
              "main": "projects/athene-webcomponents/src/test-zoneless.ts",
              "tsConfig": "projects/athene-webcomponents/tsconfig.spec.zoneless.json",
              "polyfills": []
            }
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "browserTarget": "athene-webcomponents:build:development",
            "configDir": ".storybook",
            "tsConfig": ".storybook/tsconfig.json",
            "compodoc": false,
            "styles": [
              "node_modules/@fontsource/geist/300.css",
              "node_modules/@fontsource/geist/400.css",
              "node_modules/@fontsource/geist/500.css",
              "node_modules/@fontsource/geist/600.css",
              "node_modules/@fontsource/geist/700.css",
              "node_modules/@fontsource/geist-mono/400.css",
              "node_modules/@fontsource/geist-mono/500.css",
              "node_modules/@fontsource/geist-mono/600.css",
              "projects/athene-webcomponents/src/lib/styles/main.scss"
            ],
            "port": 6006
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "browserTarget": "athene-webcomponents:build:development",
            "configDir": ".storybook",
            "tsConfig": ".storybook/tsconfig.json",
            "compodoc": false,
            "styles": [
              "node_modules/@fontsource/geist/300.css",
              "node_modules/@fontsource/geist/400.css",
              "node_modules/@fontsource/geist/500.css",
              "node_modules/@fontsource/geist/600.css",
              "node_modules/@fontsource/geist/700.css",
              "node_modules/@fontsource/geist-mono/400.css",
              "node_modules/@fontsource/geist-mono/500.css",
              "node_modules/@fontsource/geist-mono/600.css",
              "projects/athene-webcomponents/src/lib/styles/main.scss"
            ],
            "outputDir": "storybook-static"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}

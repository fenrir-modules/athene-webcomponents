{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "athenos-webcomponents": {
      "projectType": "library",
      "root": "projects/athenos-webcomponents",
      "sourceRoot": "projects/athenos-webcomponents/src",
      "prefix": "ath",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/athenos-webcomponents/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/athenos-webcomponents/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/athenos-webcomponents/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test-build": {
          "builder": "@angular/build:application",
          "options": {
            "tsConfig": "projects/athenos-webcomponents/tsconfig.spec.json",
            "polyfills": ["zone.js"],
            "styles": ["projects/athenos-webcomponents/src/lib/styles/main.scss"],
            "aot": false,
            "optimization": false,
            "extractLicenses": false
          },
          "configurations": {
            "zoneless": {
              "polyfills": []
            }
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "runner": "vitest",
            "buildTarget": ":test-build",
            "tsConfig": "projects/athenos-webcomponents/tsconfig.spec.json",
            "browsers": ["chromiumHeadless"],
            "browserViewport": "800x600",
            "splitting": false,
            "setupFiles": ["projects/athenos-webcomponents/src/test-setup.ts"],
            "reporters": ["default"]
          },
          "configurations": {
            "zoneless": {
              "buildTarget": ":test-build:zoneless",
              "providersFile": "projects/athenos-webcomponents/src/test-providers-zoneless.ts"
            }
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "browserTarget": "athenos-webcomponents:build:development",
            "configDir": ".storybook",
            "tsConfig": ".storybook/tsconfig.json",
            "compodoc": false,
            "styles": [
              "node_modules/@fontsource/geist/300.css",
              "node_modules/@fontsource/geist/400.css",
              "node_modules/@fontsource/geist/500.css",
              "node_modules/@fontsource/geist/600.css",
              "node_modules/@fontsource/geist/700.css",
              "node_modules/@fontsource/geist-mono/400.css",
              "node_modules/@fontsource/geist-mono/500.css",
              "node_modules/@fontsource/geist-mono/600.css",
              "projects/athenos-webcomponents/src/lib/styles/main.scss"
            ],
            "port": 6006
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "browserTarget": "athenos-webcomponents:build:development",
            "configDir": ".storybook",
            "tsConfig": ".storybook/tsconfig.json",
            "compodoc": false,
            "styles": [
              "node_modules/@fontsource/geist/300.css",
              "node_modules/@fontsource/geist/400.css",
              "node_modules/@fontsource/geist/500.css",
              "node_modules/@fontsource/geist/600.css",
              "node_modules/@fontsource/geist/700.css",
              "node_modules/@fontsource/geist-mono/400.css",
              "node_modules/@fontsource/geist-mono/500.css",
              "node_modules/@fontsource/geist-mono/600.css",
              "projects/athenos-webcomponents/src/lib/styles/main.scss"
            ],
            "outputDir": "storybook-static"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}

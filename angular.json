{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "athene-webcomponents": {
      "projectType": "library",
      "root": "projects/athene-webcomponents",
      "sourceRoot": "projects/athene-webcomponents/src",
      "prefix": "ath",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/athene-webcomponents/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/athene-webcomponents/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/athene-webcomponents/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/athene-webcomponents/tsconfig.spec.json",
            "polyfills": ["zone.js", "zone.js/testing"]
          }
        }
      }
    },
    "storybook-host": {
      "projectType": "application",
      "root": "projects/storybook-host",
      "sourceRoot": "projects/storybook-host/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/storybook-host",
            "index": "projects/storybook-host/src/index.html",
            "browser": "projects/storybook-host/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "projects/storybook-host/tsconfig.app.json",
            "styles": [
              "projects/athene-webcomponents/src/lib/styles/main.scss"
            ],
            "scripts": []
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}

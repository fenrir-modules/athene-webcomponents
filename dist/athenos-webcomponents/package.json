{
  "name": "@athenos/webcomponents",
  "version": "0.7.6",
  "description": "Athenos UI Component Library",
  "sideEffects": false,
  "peerDependencies": {
    "@angular/common": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/router": "^22.2.0"
  },
  "dependencies": {
    "@lucide/angular": "^1.55.0",
    "lucide": "^1.55.0",
    "tslib": "^2.3.0"
  },
  "module": "fesm2022/athenos-webcomponents.mjs",
  "typings": "types/athenos-webcomponents.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./types/athenos-webcomponents.d.ts",
      "default": "./fesm2022/athenos-webcomponents.mjs"
    },
    "./core": {
      "types": "./types/athenos-webcomponents-core.d.ts",
      "default": "./fesm2022/athenos-webcomponents-core.mjs"
    },
    "./icons": {
      "types": "./types/athenos-webcomponents-icons.d.ts",
      "default": "./fesm2022/athenos-webcomponents-icons.mjs"
    }
  },
  "type": "module"
}
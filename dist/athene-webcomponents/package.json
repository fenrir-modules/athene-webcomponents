{
  "name": "@athene/webcomponents",
  "version": "0.1.0",
  "description": "Athene UI Component Library",
  "sideEffects": false,
  "peerDependencies": {
    "@angular/common": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/router": "^20.3.0"
  },
  "dependencies": {
    "@lucide/angular": "^1.55.0",
    "lucide": "^1.55.0",
    "tslib": "^2.3.0"
  },
  "module": "fesm2022/athene-webcomponents.mjs",
  "typings": "index.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./index.d.ts",
      "default": "./fesm2022/athene-webcomponents.mjs"
    },
    "./core": {
      "types": "./core/index.d.ts",
      "default": "./fesm2022/athene-webcomponents-core.mjs"
    },
    "./icons": {
      "types": "./icons/index.d.ts",
      "default": "./fesm2022/athene-webcomponents-icons.mjs"
    }
  }
}
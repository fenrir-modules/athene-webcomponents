{
  "name": "@athene/webcomponents",
  "version": "0.1.0",
  "description": "Athene UI Component Library",
  "sideEffects": false,
  "peerDependencies": {
    "@angular/common": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/router": "^21.2.0"
  },
  "dependencies": {
    "@lucide/angular": "^1.55.0",
    "lucide": "^1.55.0",
    "tslib": "^2.3.0"
  },
  "module": "fesm2022/athene-webcomponents.mjs",
  "typings": "types/athene-webcomponents.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./types/athene-webcomponents.d.ts",
      "default": "./fesm2022/athene-webcomponents.mjs"
    },
    "./core": {
      "types": "./types/athene-webcomponents-core.d.ts",
      "default": "./fesm2022/athene-webcomponents-core.mjs"
    },
    "./icons": {
      "types": "./types/athene-webcomponents-icons.d.ts",
      "default": "./fesm2022/athene-webcomponents-icons.mjs"
    }
  },
  "type": "module"
}